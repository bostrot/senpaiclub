---
import Listing from '../../layouts/Listing.astro';
import { countBy, getPosts, slugify } from '../../lib/posts';
import { CATEGORY_LABELS } from '../../data/site';
export async function getStaticPaths() {
  const posts = await getPosts();
  return countBy(posts, 'categories').map((c) => ({
    params: { category: c.slug },
    props: { name: c.name, posts: posts.filter((p) => p.data.categories.some((x) => slugify(x) === c.slug)) },
  }));
}
const { name, posts } = Astro.props;
const label = CATEGORY_LABELS[name] ?? name;
---
<Listing eyebrow="Category" title={label} description={`${posts.length} ${posts.length === 1 ? 'post' : 'posts'} in “${label}”.`} posts={posts} />
