---
import Base from '../../layouts/Base.astro';
import { countBy, getPosts } from '../../lib/posts';
import { CATEGORY_LABELS } from '../../data/site';
const cats = countBy(await getPosts(), 'categories');
---
<Base title="Categories" description="Browse Senpai Club articles by category.">
  <div class="container">
    <header class="page-head"><h1>Categories</h1></header>
    <ul>{cats.map((c) => <li><a href={`/categories/${c.slug}/`}>{CATEGORY_LABELS[c.name] ?? c.name}</a> <span class="count">{c.count}</span></li>)}</ul>
  </div>
</Base>
<style>
  ul { list-style: none; margin: 0; padding: 0; columns: 2 12rem; column-gap: 2rem; }
  li { padding: 0.25rem 0; break-inside: avoid; }
  li a { text-decoration: none; }
  li a:hover { text-decoration: underline; text-underline-offset: 0.18em; text-decoration-thickness: 1px; }
  .count { color: var(--fg-faint); font-size: 0.85rem; font-variant-numeric: tabular-nums; }
</style>
