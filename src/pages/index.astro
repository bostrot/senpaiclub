---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import Newsletter from '../components/Newsletter.astro';
import { countBy, getPosts } from '../lib/posts';

const posts = await getPosts();
const latest = posts.slice(0, 12);
const tags = countBy(posts, 'tags').slice(0, 20);
---
<Base>
  <div class="container">
    <header class="intro">
      <p>Notes from the home lab: Linux, Windows and WSL, Proxmox, 3D printing, lasers and other hardware. Mostly step-by-step guides, written down right after something finally worked.</p>
    </header>

    <section>
      <h2 class="section-label">Recent posts</h2>
      {latest.map((p) => <PostCard post={p} />)}
      <p class="more"><a href="/archives/">All {posts.length} posts</a></p>
    </section>

    <section class="topics">
      <h2 class="section-label">Topics</h2>
      <p>{tags.map((t, i) => <>{i > 0 && ', '}<a href={`/tags/${t.slug}/`}>{t.name}</a></>)}, <a href="/tags/">more</a></p>
    </section>

    <Newsletter />
  </div>
</Base>

<style>
  .intro { padding: 2.5rem 0 2rem; }
  .intro p { margin: 0; font-family: var(--font-serif); font-size: 1.2rem; line-height: 1.6; }
  .more { margin: 0.5rem 0 0; padding-top: 1rem; border-top: 1px solid var(--border); font-size: 0.925rem; }
  .topics { margin: 3rem 0; }
  .topics p { margin: 0; color: var(--fg-muted); line-height: 1.8; }
  .topics a { color: var(--fg); text-underline-offset: 0.18em; text-decoration-thickness: 1px; text-decoration-color: var(--fg-faint); }
</style>
