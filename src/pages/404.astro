---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <div class="container nf">
    <p class="mark" aria-hidden="true">迷子</p>
    <h1>404 — page not found</h1>
    <p>That link went nowhere. The post may have moved, or the URL has a typo.</p>
    <div class="cta"><a href="/" class="btn btn-primary">Go home</a><button class="btn" data-search-open>Search</button></div>
  </div>
</Base>
<style>
  .nf { padding: 6rem 0; text-align: center; max-width: 40rem; }
  .mark { font-family: var(--font-cjk); font-size: 5rem; margin: 0; color: var(--border-strong); font-weight: 800; }
  h1 { font-size: 2rem; margin: 0.5rem 0 1rem; }
  p { color: var(--fg-muted); }
  .cta { display: flex; justify-content: center; gap: 0.75rem; margin-top: 1.5rem; }
</style>
