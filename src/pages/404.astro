---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <div class="container">
    <header class="page-head">
      <h1>Page not found</h1>
      <p>That link went nowhere. The post may have moved, or the address has a typo.</p>
    </header>
    <p><a href="/">Go to the home page</a> or <button type="button" class="link" data-search-open>search the posts</button>.</p>
  </div>
</Base>
<style>
  .link { padding: 0; border: 0; background: none; text-decoration: underline; cursor: pointer; }
</style>
