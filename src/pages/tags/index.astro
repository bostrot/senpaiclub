---
import Base from '../../layouts/Base.astro';
import { countBy, getPosts } from '../../lib/posts';
const tags = countBy(await getPosts(), 'tags');
---
<Base title="Tags" description="Browse Senpai Club articles by tag.">
  <div class="container page">
    <p class="eyebrow"><span class="jp" lang="ja">分類</span>Browse</p>
    <h1>Tags</h1>
    <p class="lead">{tags.length} tags across all posts.</p>
    <div class="cloud">{tags.map((t) => <a class="pill" href={`/tags/${t.slug}/`}>{t.name} <span class="count">{t.count}</span></a>)}</div>
  </div>
</Base>
<style>
  .page { padding-top: 3rem; max-width: 52rem; }
  h1 { font-size: clamp(2rem, 4vw, 2.75rem); margin: 0.4rem 0 0.75rem; }
  .lead { color: var(--fg-muted); margin: 0 0 2rem; }
  .cloud { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .pill { font-size: 0.9rem; padding: 0.4rem 0.9rem; }
</style>
