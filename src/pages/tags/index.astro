---
import Base from '../../layouts/Base.astro';
import { countBy, getPosts } from '../../lib/posts';
const tags = countBy(await getPosts(), 'tags');
---
<Base title="Tags" description="Browse Senpai Club articles by tag.">
  <div class="container">
    <header class="page-head">
      <h1>Tags</h1>
      <p>{tags.length} tags across all posts.</p>
    </header>
    <ul>{tags.map((t) => <li><a href={`/tags/${t.slug}/`}>{t.name}</a> <span class="count">{t.count}</span></li>)}</ul>
  </div>
</Base>
<style>
  ul { list-style: none; margin: 0; padding: 0; columns: 2 12rem; column-gap: 2rem; }
  li { padding: 0.25rem 0; break-inside: avoid; }
  li a { text-decoration: none; }
  li a:hover { text-decoration: underline; text-underline-offset: 0.18em; text-decoration-thickness: 1px; }
  .count { color: var(--fg-faint); font-size: 0.85rem; font-variant-numeric: tabular-nums; }
</style>
