---
import Base from '../layouts/Base.astro';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
const years = [...new Set(posts.map((p) => p.data.date.getFullYear()))];
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: '2-digit', timeZone: 'Europe/Berlin' });
---
<Base title="All posts" description="Every article on Senpai Club, newest first.">
  <div class="container">
    <header class="page-head">
      <h1>All posts</h1>
      <p>{posts.length} posts since {years.at(-1)}. Press <kbd>/</kbd> to search.</p>
    </header>
    {years.map((y) => (
      <section class="year">
        <h2>{y}</h2>
        <ol>
          {posts.filter((p) => p.data.date.getFullYear() === y).map((p) => (
            <li>
              <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
              <a href={`/${p.id}/`}>{p.data.title}</a>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</Base>

<style>
  kbd { font-family: var(--font-mono); font-size: 0.8em; padding: 0 0.3em; border: 1px solid var(--border-strong); border-radius: 3px; }
  .year { padding: 1rem 0; border-top: 1px solid var(--border); }
  .year h2 { font-size: 0.95rem; color: var(--fg-faint); font-weight: 600; font-variant-numeric: tabular-nums; margin-bottom: 0.4rem; }
  ol { list-style: none; margin: 0; padding: 0; }
  li { display: grid; grid-template-columns: 4rem minmax(0, 1fr); gap: 0.75rem; padding: 0.3rem 0; align-items: baseline; }
  time { font-size: 0.825rem; color: var(--fg-faint); font-variant-numeric: tabular-nums; }
  li a { text-decoration: none; line-height: 1.4; }
  li a:hover { text-decoration: underline; text-underline-offset: 0.18em; text-decoration-thickness: 1px; }
</style>
