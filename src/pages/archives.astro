---
import Base from '../layouts/Base.astro';
import { getPosts, readTime, slugify } from '../lib/posts';
import { CATEGORY_LABELS } from '../data/site';

const posts = await getPosts();
const years = [...new Set(posts.map((p) => p.data.date.getFullYear()))];
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: '2-digit', timeZone: 'Europe/Berlin' });
---
<Base title="All posts" description="Every article on Senpai Club, newest first.">
  <div class="container page">
    <header class="head">
      <p class="eyebrow"><span class="jp" lang="ja">記事</span>Archive</p>
      <h1>All posts</h1>
      <p class="lead">{posts.length} articles since {years.at(-1)}. Use <kbd>⌘K</kbd> to search.</p>
    </header>
    {years.map((y) => (
      <section class="year">
        <h2>{y}</h2>
        <ol>
          {posts.filter((p) => p.data.date.getFullYear() === y).map((p) => (
            <li>
              <a href={`/${p.id}/`} class="row">
                <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
                <span class="title">{p.data.title}</span>
                <span class="meta">
                  {p.data.categories[0] && <span class="cat">{CATEGORY_LABELS[p.data.categories[0]] ?? p.data.categories[0]}</span>}
                  <span>{readTime(p).minutes} min</span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</Base>

<style>
  .page { padding-top: 3rem; max-width: 52rem; }
  .head { margin-bottom: 2.5rem; }
  h1 { font-size: clamp(2rem, 4vw, 2.75rem); margin: 0.4rem 0 0.75rem; }
  .lead { color: var(--fg-muted); margin: 0; }
  kbd { font-family: var(--font-mono); font-size: 0.8em; padding: 0.1em 0.4em; border: 1px solid var(--border-strong); border-radius: 5px; }
  .year { display: grid; grid-template-columns: 6rem 1fr; gap: 1.5rem; padding: 1.5rem 0; border-top: 1px solid var(--border); }
  .year h2 { font-size: 1.5rem; color: var(--fg-faint); font-variant-numeric: tabular-nums; }
  ol { list-style: none; margin: 0; padding: 0; }
  .row { display: grid; grid-template-columns: 4.5rem 1fr auto; align-items: baseline; gap: 1rem; padding: 0.55rem 0.5rem; margin: 0 -0.5rem; border-radius: 8px; transition: background 0.15s; }
  .row:hover { background: var(--bg-subtle); }
  .row:hover .title { color: var(--accent); }
  time { font-family: var(--font-mono); font-size: 0.8rem; color: var(--fg-faint); }
  .title { font-weight: 500; }
  .meta { display: flex; gap: 0.75rem; font-size: 0.75rem; color: var(--fg-faint); font-family: var(--font-mono); white-space: nowrap; }
  .cat { color: var(--accent); text-transform: uppercase; letter-spacing: 0.05em; }
  @media (max-width: 640px) { .year { grid-template-columns: 1fr; gap: 0.5rem; } .row { grid-template-columns: 4.5rem 1fr; } .meta { display: none; } }
</style>
