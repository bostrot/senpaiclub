---
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import Toc from '../components/Toc.astro';
import Giscus from '../components/Giscus.astro';
import Newsletter from '../components/Newsletter.astro';
import Share from '../components/Share.astro';
import PostCard from '../components/PostCard.astro';
import Cover from '../components/Cover.astro';
import { AUTHORS, CATEGORY_LABELS, SITE } from '../data/site';
import { excerpt, fmtDate, lastModified, readTime, related, slugify, type Post } from '../lib/posts';

interface Props { post: Post; headings: MarkdownHeading[]; all: Post[]; }
const { post, headings, all } = Astro.props;
const { title, date, tags, categories, author: authorId, comments } = post.data;
const author = AUTHORS[authorId];
const modified = post.data.updated ?? lastModified(post);
const rt = readTime(post);
const desc = excerpt(post, 160);
const url = new URL(`/${post.id}/`, Astro.site).href;
const idx = all.findIndex((p) => p.id === post.id);
const newer = all[idx - 1];
const older = all[idx + 1];
const rel = related(post, all);
const cat = categories[0];
const editUrl = `${SITE.repo}/edit/main/${post.filePath}`;
---
<Base title={title} ogTitle={title} description={desc} image={`/og/${post.id}.png`} type="article" published={date} modified={modified} tags={tags} author={author?.name}>
  <article class="post container" data-pagefind-body>
    <header class="post-header">
      <div class="crumbs" data-pagefind-ignore>
        <a href="/">Home</a><span>/</span>
        {cat ? <a href={`/categories/${slugify(cat)}/`}>{CATEGORY_LABELS[cat] ?? cat}</a> : <a href="/archives/">Posts</a>}
      </div>
      <h1 transition:name={`title-${post.id}`}>{title}</h1>
      <div class="meta" data-pagefind-ignore>
        {author && (
          <span class="author"><span class="avatar" aria-hidden="true">{author.initials}</span>
            {author.url ? <a href={author.url} rel="author" target="_blank">{author.name}</a> : author.name}</span>
        )}
        <span class="sep" aria-hidden="true">·</span>
        <time datetime={date.toISOString()}>{fmtDate(date)}</time>
        {modified && <><span class="sep" aria-hidden="true">·</span><span title={modified.toISOString()}>Updated {fmtDate(modified)}</span></>}
        <span class="sep" aria-hidden="true">·</span>
        <span>{rt.minutes} min read</span>
      </div>
      {tags.length > 0 && (
        <div class="tags" data-pagefind-ignore>
          {tags.map((t) => <a class="pill" href={`/tags/${slugify(t)}/`}>#{t}</a>)}
        </div>
      )}
    </header>

    <div class="hero-cover"><Cover post={post} variant="wide" eager /></div>

    <div class="layout">
      <div class="prose" id="content">
        <slot />
      </div>
      <aside class="side" data-pagefind-ignore>
        <div class="sticky">
          <Toc headings={headings} />
          <div class="side-actions">
            <a href="#main" class="top">↑ Back to top</a>
            <a href={editUrl} target="_blank" rel="noopener">Edit on GitHub</a>
          </div>
        </div>
      </aside>
    </div>

    <footer class="post-footer" data-pagefind-ignore>
      <Share title={title} url={url} />

      {author && (
        <div class="author-card card">
          <span class="avatar lg" aria-hidden="true">{author.initials}</span>
          <div>
            <p class="eyebrow"><span class="jp" lang="ja">筆者</span>Written by</p>
            <h3>{author.url ? <a href={author.url} target="_blank" rel="author noopener">{author.name}</a> : author.name}</h3>
            <p>{author.bio}</p>
          </div>
        </div>
      )}

      <nav class="pager" aria-label="Adjacent posts">
        {older ? <a href={`/${older.id}/`} class="card prev"><span>← Older</span><strong>{older.data.title}</strong></a> : <span />}
        {newer ? <a href={`/${newer.id}/`} class="card next"><span>Newer →</span><strong>{newer.data.title}</strong></a> : <span />}
      </nav>

      {rel.length > 0 && (
        <section class="related">
          <div class="section-head"><h2 class="section-title"><span class="jp" lang="ja">関連</span>Related posts</h2><a href="/archives/">All posts</a></div>
          <div class="grid">{rel.map((p) => <PostCard post={p} />)}</div>
        </section>
      )}

      <Newsletter />
      {comments && <Giscus />}
    </footer>
  </article>
</Base>

<style>
  .post { padding-top: 2.5rem; }
  .post-header { max-width: var(--prose); margin-bottom: 2.5rem; }
  .crumbs { display: flex; gap: 0.5rem; font-size: 0.85rem; color: var(--fg-faint); margin-bottom: 1rem; }
  .crumbs a:hover { color: var(--accent); }
  h1 { font-size: clamp(1.9rem, 4.2vw, 2.9rem); line-height: 1.1; margin-bottom: 1.1rem; }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; color: var(--fg-muted); font-size: 0.9rem; }
  .sep { color: var(--fg-faint); }
  .author { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--fg); font-weight: 500; }
  .author a:hover { color: var(--accent); }
  .avatar { display: inline-grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: var(--accent-soft); color: var(--accent); font-family: var(--font-mono); font-size: 0.65rem; font-weight: 700; }
  .avatar.lg { width: 56px; height: 56px; font-size: 1rem; flex-shrink: 0; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 1.1rem; }

  .hero-cover { max-width: var(--prose); margin: 0 0 2.5rem; }
  .layout { display: grid; grid-template-columns: minmax(0, var(--prose)) 1fr; gap: 4rem; align-items: start; }
  .side { position: relative; }
  .sticky { position: sticky; top: calc(var(--header-h) + 2rem); max-height: calc(100dvh - var(--header-h) - 3rem); overflow: auto; }
  .side-actions { margin-top: 1.25rem; display: flex; flex-direction: column; gap: 0.4rem; font-size: 0.8rem; }
  .side-actions a { color: var(--fg-faint); }
  .side-actions a:hover { color: var(--accent); }
  @media (max-width: 960px) { .layout { grid-template-columns: 1fr; gap: 2rem; } .side { order: -1; } .sticky { position: static; max-height: none; } .side-actions { display: none; } }

  .post-footer { max-width: var(--prose); margin-top: 3.5rem; display: flex; flex-direction: column; gap: 2.5rem; }
  .author-card { display: flex; gap: 1.25rem; padding: 1.5rem; align-items: flex-start; }
  .author-card h3 { font-size: 1.15rem; margin: 0.2rem 0 0.4rem; }
  .author-card h3 a:hover { color: var(--accent); }
  .author-card p:last-child { margin: 0; color: var(--fg-muted); font-size: 0.925rem; }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .pager a { display: flex; flex-direction: column; gap: 0.3rem; padding: 1rem 1.25rem; transition: border-color 0.15s, transform 0.15s; }
  .pager a:hover { border-color: var(--border-strong); transform: translateY(-1px); }
  .pager a span { font-size: 0.75rem; color: var(--fg-faint); font-family: var(--font-mono); }
  .pager a strong { font-family: var(--font-display); font-weight: 600; font-size: 0.95rem; line-height: 1.3; }
  .pager .next { text-align: right; }
  .related { max-width: none; }
  .related .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1rem; }
  @media (max-width: 560px) { .pager { grid-template-columns: 1fr; } }
</style>
