---
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import Toc from '../components/Toc.astro';
import Giscus from '../components/Giscus.astro';
import Newsletter from '../components/Newsletter.astro';
import Share from '../components/Share.astro';
import PostCard from '../components/PostCard.astro';
import Cover from '../components/Cover.astro';
import { AUTHORS, CATEGORY_LABELS, SITE } from '../data/site';
import { excerpt, fmtDate, lastModified, readTime, related, slugify, type Post } from '../lib/posts';

interface Props { post: Post; headings: MarkdownHeading[]; all: Post[]; }
const { post, headings, all } = Astro.props;
const { title, date, tags, categories, author: authorId, comments } = post.data;
const author = AUTHORS[authorId];
const modified = post.data.updated ?? lastModified(post);
const rt = readTime(post);
const desc = excerpt(post, 160);
const url = new URL(`/${post.id}/`, Astro.site).href;
const idx = all.findIndex((p) => p.id === post.id);
const newer = all[idx - 1];
const older = all[idx + 1];
const rel = related(post, all);
const cat = categories[0];
const editUrl = `${SITE.repo}/edit/main/${post.filePath}`;
---
<Base title={title} ogTitle={title} description={desc} image={`/og/${post.id}.png`} type="article" published={date} modified={modified} tags={tags} author={author?.name}>
  <article class="post container" data-pagefind-body>
    <header class="post-header">
      <h1 transition:name={`title-${post.id}`}>{title}</h1>
      <p class="meta" data-pagefind-ignore>
        {author && <>{author.url ? <a href={author.url} rel="author" target="_blank">{author.name}</a> : author.name} · </>}
        <time datetime={date.toISOString()}>{fmtDate(date)}</time>
        {modified && <> · <span title={modified.toISOString()}>updated {fmtDate(modified)}</span></>}
        {' '}· {rt.minutes} min read
      </p>
    </header>

    <Cover post={post} eager />
    <div data-pagefind-ignore><Toc headings={headings} /></div>

    <div class="prose" id="content">
      <slot />
    </div>

    <footer class="post-footer" data-pagefind-ignore>
      {tags.length > 0 && (
        <p class="tags">Tagged {tags.map((t, i) => <>{i > 0 && ', '}<a href={`/tags/${slugify(t)}/`}>{t}</a></>)}{cat && <> in <a href={`/categories/${slugify(cat)}/`}>{CATEGORY_LABELS[cat] ?? cat}</a></>}.</p>
      )}
      <Share title={title} url={url} />
      <p class="edit"><a href={editUrl} target="_blank" rel="noopener">Suggest an edit on GitHub</a></p>

      {author && (
        <section class="author">
          <p><strong>{author.url ? <a href={author.url} target="_blank" rel="author noopener">{author.name}</a> : author.name}</strong> · {author.bio}</p>
        </section>
      )}

      <nav class="pager" aria-label="Adjacent posts">
        {older && <a href={`/${older.id}/`} class="prev"><span>Older</span>{older.data.title}</a>}
        {newer && <a href={`/${newer.id}/`} class="next"><span>Newer</span>{newer.data.title}</a>}
      </nav>

      {rel.length > 0 && (
        <section class="related">
          <h2 class="section-label">Related</h2>
          {rel.map((p) => <PostCard post={p} excerptLength={0} />)}
        </section>
      )}

      <Newsletter />
      {comments && <Giscus />}
    </footer>
  </article>
</Base>

<style>
  .post-header { padding: 2.5rem 0 1.75rem; }
  h1 { font-size: clamp(1.7rem, 5vw, 2.3rem); line-height: 1.2; letter-spacing: -0.015em; }
  .meta { margin: 0.75rem 0 0; color: var(--fg-faint); font-size: 0.9rem; }
  .meta a { color: var(--fg-muted); text-decoration: none; }
  .meta a:hover { text-decoration: underline; }

  .post-footer { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--border); display: flex; flex-direction: column; gap: 1.5rem; font-size: 0.925rem; }
  .post-footer p { margin: 0; }
  .tags { color: var(--fg-muted); }
  .tags a { color: var(--fg); text-underline-offset: 0.18em; text-decoration-thickness: 1px; }
  .edit { margin-top: -0.75rem !important; }
  .edit a { color: var(--fg-faint); font-size: 0.85rem; }
  .author p { color: var(--fg-muted); line-height: 1.55; }
  .author strong { color: var(--fg); font-weight: 600; }
  .author a { text-decoration: none; }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .pager a { display: flex; flex-direction: column; gap: 0.15rem; text-decoration: none; font-weight: 550; line-height: 1.35; }
  .pager a:hover { text-decoration: underline; text-underline-offset: 0.18em; }
  .pager span { font-size: 0.8rem; font-weight: 400; color: var(--fg-faint); }
  .pager .next { grid-column: 2; text-align: right; }
  @media (max-width: 520px) { .pager { grid-template-columns: 1fr; } .pager .next { grid-column: 1; text-align: left; } }
</style>
