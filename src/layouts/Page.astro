---
import Base from './Base.astro';
interface Props { title: string; description?: string; eyebrow?: string; noindex?: boolean; }
const { title, description, noindex } = Astro.props;
---
<Base title={title} description={description} noindex={noindex}>
  <div class="container">
    <header class="page-head">
      <h1>{title}</h1>
      {description && <p>{description}</p>}
    </header>
    <div class="prose"><slot /></div>
  </div>
</Base>
