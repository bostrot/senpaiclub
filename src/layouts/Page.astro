---
import Base from './Base.astro';
interface Props { title: string; description?: string; eyebrow?: string; noindex?: boolean; }
const { title, description, eyebrow, noindex } = Astro.props;
---
<Base title={title} description={description} noindex={noindex}>
  <div class="container page">
    <header class="head">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      {description && <p class="lead">{description}</p>}
    </header>
    <div class="prose"><slot /></div>
  </div>
</Base>
<style>
  .page { padding-top: 3rem; max-width: var(--prose); }
  .head { margin-bottom: 2.5rem; }
  h1 { font-size: clamp(2rem, 4vw, 2.75rem); margin: 0.4rem 0 0.75rem; }
  .lead { color: var(--fg-muted); margin: 0; font-size: 1.1rem; }
</style>
