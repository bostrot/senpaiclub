---
import { SITE } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container inner">
    <nav aria-label="Footer">
      <a href="/archives/">Posts</a>
      <a href="/tags/">Tags</a>
      <a href="/about/">About</a>
      <a href="/feed.xml">RSS</a>
      <a href={SITE.github} target="_blank" rel="noopener">GitHub</a>
      <a href={`mailto:${SITE.email}`}>Email</a>
      <a href="/imprint/">Imprint</a>
    </nav>
    <p>© {year} {SITE.author}. No cookies; page views are counted with <a href="https://plausible.io" target="_blank" rel="noopener">Plausible</a>.</p>
  </div>
</footer>

<style>
  .site-footer { margin-top: 5rem; border-top: 1px solid var(--border); font-size: 0.85rem; color: var(--fg-faint); }
  .inner { padding: 1.75rem 0 2.5rem; }
  nav { display: flex; flex-wrap: wrap; gap: 0.4rem 1.1rem; }
  nav a { color: var(--fg-muted); text-decoration: none; }
  nav a:hover { color: var(--fg); }
  p { margin: 0.9rem 0 0; }
  p a { color: inherit; }
</style>
