---
import { SITE } from '../data/site';
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
const n = SITE.newsletter;
---
<section class="newsletter" aria-label="Newsletter">
  <h2>Get new posts by email</h2>
  <p>Only when something new is up. No schedule, no spam.</p>
  <form action={n.action} method="post" target="_blank" class="form">
    <label class="sr-only" for="nl-email">Email address</label>
    <input id="nl-email" type="email" name="EMAIL" placeholder="you@example.com" required autocomplete="email" />
    <input type="hidden" name="tags" value={n.tag} />
    <div style="position:absolute;left:-5000px" aria-hidden="true"><input type="text" name={n.honeypot} tabindex="-1" value="" /></div>
    <button type="submit" class="btn">Subscribe</button>
  </form>
</section>

<style>
  .newsletter { padding: 1.5rem 0 0; border-top: 1px solid var(--border); }
  h2 { font-size: 1rem; }
  p { margin: 0.3rem 0 0.9rem; color: var(--fg-muted); font-size: 0.925rem; }
  .form { display: flex; flex-wrap: wrap; gap: 0.5rem; position: relative; }
  input[type='email'] { flex: 1 1 14rem; min-width: 0; padding: 0.45rem 0.7rem; border: 1px solid var(--border-strong); border-radius: 4px; background: var(--bg); color: var(--fg); font: inherit; font-size: 0.925rem; }
  input[type='email']:focus { outline: none; border-color: var(--fg); }
</style>
