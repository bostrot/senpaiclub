---
/** The post's own photo, if it has one. Posts without a photo get no cover. */
import type { Post } from '../lib/posts';

interface Props { post: Post; eager?: boolean; }
const { post, eager = false } = Astro.props;
const image = post.data.image;
---
{image && (
  <figure class="cover">
    <img src={image} alt="" loading={eager ? 'eager' : 'lazy'} decoding="async" />
  </figure>
)}

<style>
  .cover { margin: 0 0 2rem; }
  .cover img { display: block; width: 100%; height: auto; max-height: 24rem; object-fit: cover; border-radius: 3px; }
</style>
