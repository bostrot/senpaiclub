---
/** One post in a list: title, date and a short excerpt. */
import type { Post } from '../lib/posts';
import { excerpt, fmtDate, readTime } from '../lib/posts';

interface Props { post: Post; excerptLength?: number; }
const { post, excerptLength = 160 } = Astro.props;
---
<article class="post-item">
  <h3><a href={`/${post.id}/`}>{post.data.title}</a></h3>
  <p class="meta"><time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date)}</time> · {readTime(post).minutes} min read</p>
  {excerptLength > 0 && <p class="excerpt">{excerpt(post, excerptLength)}</p>}
</article>

<style>
  .post-item { padding: 1.1rem 0; border-top: 1px solid var(--border); }
  h3 { font-size: 1.1rem; font-weight: 600; line-height: 1.35; }
  h3 a { text-decoration: none; }
  h3 a:hover { text-decoration: underline; text-underline-offset: 0.18em; text-decoration-thickness: 1px; }
  .meta { margin: 0.25rem 0 0; font-size: 0.825rem; color: var(--fg-faint); font-variant-numeric: tabular-nums; }
  .excerpt { margin: 0.4rem 0 0; color: var(--fg-muted); font-size: 0.95rem; line-height: 1.55; }
</style>
