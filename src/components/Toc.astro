---
import type { MarkdownHeading } from 'astro';
interface Props { headings: MarkdownHeading[]; }
const headings = Astro.props.headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---
{headings.length > 2 && (
  <details class="toc">
    <summary>Contents</summary>
    <ol>
      {headings.map((h) => (
        <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>
      ))}
    </ol>
  </details>
)}

<style>
  .toc { margin: 0 0 2rem; font-size: 0.9rem; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); padding: 0.6rem 0; }
  summary { cursor: pointer; color: var(--fg-muted); }
  summary:hover { color: var(--fg); }
  ol { list-style: none; margin: 0.6rem 0 0.2rem; padding: 0; }
  li { padding: 0.15rem 0; }
  li.d3 { padding-left: 1.1rem; }
  a { color: var(--fg-muted); text-decoration: none; }
  a:hover { color: var(--fg); text-decoration: underline; }
</style>
