---
interface Props { title: string; url: string; }
const { title, url } = Astro.props;
const t = encodeURIComponent(title), u = encodeURIComponent(url);
const links = [
  { label: 'X', href: `https://twitter.com/intent/tweet?text=${t}&url=${u}` },
  { label: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}` },
  { label: 'Hacker News', href: `https://news.ycombinator.com/submitlink?u=${u}&t=${t}` },
  { label: 'Reddit', href: `https://www.reddit.com/submit?url=${u}&title=${t}` },
  { label: 'Telegram', href: `https://t.me/share/url?url=${u}&text=${t}` },
];
---
<p class="share">
  Share:
  {links.map((l) => <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a>)}
  <button type="button" data-copy={url}>Copy link</button>
</p>

<style>
  .share { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.3rem 0.9rem; margin: 0; font-size: 0.875rem; color: var(--fg-faint); }
  a, button { color: var(--fg-muted); text-decoration: none; }
  a:hover, button:hover { color: var(--fg); text-decoration: underline; }
  button { padding: 0; border: 0; background: none; font-size: inherit; cursor: pointer; }
</style>

<script>
  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-copy]');
    if (!btn) return;
    try {
      await navigator.clipboard.writeText(btn.dataset.copy!);
      const old = btn.textContent; btn.textContent = 'Copied!';
      setTimeout(() => (btn.textContent = old), 1500);
    } catch {}
  });
</script>
